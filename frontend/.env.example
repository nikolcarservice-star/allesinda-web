# Backend API URL (without trailing slash).
# Local: http://localhost:8000
# Production public API URL (build-time; used by browser /api-proxy and SSR)
# Requires DNS: api.allesinda.de → your server. Until then use https://api.allesinda.com
NEXT_PUBLIC_API_URL=https://api.allesinda.de
# Server-only proxy target (runtime). Coolify: copy Backend "internal URL" host, port 8000.
# API_URL=http://<backend-container-id>:8000
# Until api.allesinda.de has valid SSL:
# API_URL=https://api.allesinda.de
# API_TLS_INSECURE=true

# Canonical public site URL (used for metadata and domain redirects in production).
# Production: https://allesinda.de
NEXT_PUBLIC_SITE_URL=https://allesinda.de
