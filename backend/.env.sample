ENVIRONMENT=development
SECRET_KEY=secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://postgres:temppasswd@localhost:5432/allesinda
POSTGRES_USER=allesinda
POSTGRES_PASSWORD=
POSTGRES_DB=allesinda
POSTGRES_PORT=5432
STRIPE_SECRET_KEY=sk_test_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_webhook_secret
STRIPE_COMMISSION_RATE=0.10
S3_BUCKET_NAME=s3-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key
CDN_URL=https://cdn-url.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=test_twilio_account_sid
TWILIO_AUTH_TOKEN=test_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Production canonical API URL (host redirects + absolute media links)
# BASE_URL=https://api.allesinda.de
# Web Push (optional): for PWA push when app is on home screen.
# Generate keys:  pip install py-vapid  &&  python scripts/generate_vapid_keys.py
# Or:  npx web-push generate-vapid-keys
# Then set both (public key is safe to expose; keep private key secret):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
ENABLE_POSTGIS=false
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
FACEBOOK_CLIENT_ID=facebook_client_id
FACEBOOK_CLIENT_SECRET=facebook_client_secret
VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_HOURS=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
LOG_LEVEL=INFO
# If your proxy serves the API under a path (e.g. https://api.example.com/api), set API_PREFIX=/api and set frontend NEXT_PUBLIC_API_URL=https://api.example.com/api
# API_PREFIX=
UPLOAD_FOLDER=uploads
MEDIA_URL_PREFIX=/media/files
SEED_DB_ON_START=true
SEED_CREATE_MEDIA_FILES=true